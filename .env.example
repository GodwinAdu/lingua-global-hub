# Template only. Copy to .env.local and fill in real values there.
# This file is committed to git: never put real keys or passwords here.

# Public base URL, used for canonical URLs, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=firstlingualconsult@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=firstlingualconsult@gmail.com
EMAIL_TO=firstlingualconsult@gmail.com

# Supabase - Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Database password, only for running migrations from this machine (Project Settings > Database).
# The app doesn't use it; don't add it to Vercel.
SUPABASE_DB_PASSWORD=

# Optional: secret used to anonymise visitors for likes/views (any long random string).
# Falls back to SUPABASE_SECRET_KEY. Changing it resets who has liked what.
VISITOR_HASH_SECRET=

# Paystack (paid ebooks) - Dashboard > Settings > API Keys & Webhooks. Server-only.
PAYSTACK_SECRET_KEY=
# Optional, recommended: webhook signing secret (whsec_...) from Developers > API configuration.
# Without it, webhooks are verified with the legacy x-paystack-signature header.
PAYSTACK_WEBHOOK_SECRET=
